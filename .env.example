# Copy to .env and fill in real values. .env is gitignored.

# OpenAI API key for the Fittaz Coach AI chat.
OPENAI_API_KEY=""

# Local Postgres ("holding-postgres" container, exposed on host port 5433).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fittaz?schema=public"

# JWT signing secret. Rotate by setting a new value and restarting the
# server (all existing tokens become invalid). Generate with:
#   openssl rand -base64 48
JWT_SECRET=""

# Optional: HTTP port. Defaults to 4040.
# PORT=4040

# Optional: comma-separated list of origins to whitelist for CORS in
# production, e.g. https://admin.fittaz.com,https://app.fittaz.com.
# Leaving this empty allows all origins (dev only).
# CORS_ORIGINS=""

# Razorpay credentials.
#   - Test keys start with `rzp_test_…`, live with `rzp_live_…`.
#   - Get yours at https://dashboard.razorpay.com/app/keys
#   - The secret MUST stay server-side; the key id is sent to the
#     Flutter client so it can open the Razorpay checkout sheet.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# SMTP (outbound OTP email: password reset + email verification).
# Leave SMTP_HOST/SMTP_USER/SMTP_PASS empty to print codes to the console
# instead of sending real mail (the default for local dev).
#   - Gmail: use an App Password (needs 2FA) from
#     https://myaccount.google.com/apppasswords — spaces are stripped.
#   - Port 587 = STARTTLS, port 465 = implicit TLS (SMTP_SECURE inferred
#     from the port unless you set it explicitly to true/false).
SMTP_HOST=""
SMTP_PORT=587
# SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Defaults to SMTP_USER / "Fittaz" when unset.
# SMTP_FROM=""
# SMTP_FROM_NAME="Fittaz"
